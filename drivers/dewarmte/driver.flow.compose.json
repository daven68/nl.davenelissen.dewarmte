{
  "triggers": [
    {
      "id": "pump_state_changed",
      "title": {
        "en": "The heat pump status changed",
        "nl": "De warmtepompstatus is gewijzigd"
      },
      "tokens": [
        {
          "name": "state",
          "type": "string",
          "title": {
            "en": "Status",
            "nl": "Status"
          },
          "example": {
            "en": "Heating",
            "nl": "Verwarmen"
          }
        }
      ]
    },
    {
      "id": "pump_state_on",
      "title": {
        "en": "The heat pump switched on",
        "nl": "De warmtepomp is aangegaan"
      }
    },
    {
      "id": "pump_state_heating",
      "title": {
        "en": "The heat pump started heating",
        "nl": "De warmtepomp is gaan verwarmen"
      }
    },
    {
      "id": "pump_state_standby",
      "title": {
        "en": "The heat pump entered standby",
        "nl": "De warmtepomp is naar stand-by gegaan"
      }
    },
    {
      "id": "pump_state_defrosting",
      "title": {
        "en": "The defrosting cycle started",
        "nl": "De ontdooicyclus is gestart"
      }
    },
    {
      "id": "pump_state_off",
      "title": {
        "en": "The heat pump switched off",
        "nl": "De warmtepomp is uitgeschakeld"
      }
    },
    {
      "id": "measure_target_temperature_changed",
      "title": {
        "en": "The target supply temperature changed",
        "nl": "De doelaanvoertemperatuur is gewijzigd"
      },
      "tokens": [
        {
          "name": "temperature",
          "type": "number",
          "title": {
            "en": "Target supply temperature",
            "nl": "Doelaanvoertemperatuur"
          },
          "example": 35
        }
      ]
    },
    {
      "id": "gas_boiler_active_true",
      "title": {
        "en": "The gas boiler became active",
        "nl": "De cv-ketel is actief geworden"
      }
    },
    {
      "id": "gas_boiler_active_false",
      "title": {
        "en": "The gas boiler became inactive",
        "nl": "De cv-ketel is niet meer actief"
      }
    },
    {
      "id": "thermostat_active_true",
      "title": {
        "en": "The thermostat became active",
        "nl": "De thermostaat is actief geworden"
      }
    },
    {
      "id": "thermostat_active_false",
      "title": {
        "en": "The thermostat became inactive",
        "nl": "De thermostaat is niet meer actief"
      }
    },
    {
      "id": "outdoor_temperature_changed",
      "title": {
        "en": "The outdoor temperature changed",
        "nl": "De buitentemperatuur is veranderd"
      },
      "tokens": [
        {
          "name": "temperature",
          "type": "number",
          "title": {
            "en": "Outdoor temperature",
            "nl": "Buitentemperatuur"
          },
          "example": 7
        }
      ],
      "$filter": "capabilities=measure_outdoor_temperature"
    },
    {
      "id": "electric_backup_active_true",
      "title": {
        "en": "The electric backup heater turned on",
        "nl": "De elektrische bijverwarming is aangegaan"
      },
      "$filter": "capabilities=electric_backup_active"
    },
    {
      "id": "electric_backup_active_false",
      "title": {
        "en": "The electric backup heater turned off",
        "nl": "De elektrische bijverwarming is uitgegaan"
      },
      "$filter": "capabilities=electric_backup_active"
    }
  ],
  "conditions": [
    {
      "id": "pump_state_is",
      "title": {
        "en": "The heat pump status is a value",
        "nl": "De warmtepompstatus heeft een waarde"
      },
      "titleFormatted": {
        "en": "The heat pump status is [[state]]",
        "nl": "De warmtepompstatus is [[state]]"
      },
      "args": [
        {
          "name": "state",
          "type": "dropdown",
          "title": {
            "en": "Status",
            "nl": "Status"
          },
          "values": [
            {
              "id": "on",
              "label": {
                "en": "On",
                "nl": "Aan"
              }
            },
            {
              "id": "heating",
              "label": {
                "en": "Heating",
                "nl": "Verwarmen"
              }
            },
            {
              "id": "standby",
              "label": {
                "en": "Standby",
                "nl": "Stand-by"
              }
            },
            {
              "id": "defrosting",
              "label": {
                "en": "Defrosting",
                "nl": "Ontdooicyclus"
              }
            },
            {
              "id": "off",
              "label": {
                "en": "Off",
                "nl": "Uit"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "pump_is_on",
      "title": {
        "en": "The heat pump !{{is|isn't}} on",
        "nl": "De warmtepomp !{{is|is niet}} aan"
      }
    },
    {
      "id": "target_supply_temperature_above",
      "title": {
        "en": "The target supply temperature is above a value",
        "nl": "De doelaanvoertemperatuur is hoger dan een waarde"
      },
      "titleFormatted": {
        "en": "The target supply temperature is !{{above|below}} [[temperature]] °C",
        "nl": "De doelaanvoertemperatuur is !{{hoger|lager}} dan [[temperature]] °C"
      },
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "title": {
            "en": "Temperature (°C)",
            "nl": "Temperatuur (°C)"
          },
          "min": 0,
          "max": 100,
          "step": 0.1
        }
      ]
    },
    {
      "id": "gas_boiler_is_active",
      "title": {
        "en": "The gas boiler !{{is|isn't}} active",
        "nl": "De cv-ketel !{{is|is niet}} actief"
      }
    },
    {
      "id": "thermostat_is_active",
      "title": {
        "en": "The thermostat !{{is|isn't}} active",
        "nl": "De thermostaat !{{is|is niet}} actief"
      }
    },
    {
      "id": "outdoor_temperature_above",
      "title": {
        "en": "The outdoor temperature is above a value",
        "nl": "De buitentemperatuur is hoger dan een waarde"
      },
      "titleFormatted": {
        "en": "The outdoor temperature is !{{above|below}} [[temperature]] °C",
        "nl": "De buitentemperatuur is !{{hoger|lager}} dan [[temperature]] °C"
      },
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "title": {
            "en": "Temperature (°C)",
            "nl": "Temperatuur (°C)"
          },
          "min": -40,
          "max": 50,
          "step": 0.5
        }
      ],
      "$filter": "capabilities=measure_outdoor_temperature"
    },
    {
      "id": "cop_today_above",
      "title": {
        "en": "Today's COP is above a value",
        "nl": "COP vandaag is hoger dan een waarde"
      },
      "titleFormatted": {
        "en": "Today's COP is !{{above|below}} [[cop]]",
        "nl": "COP vandaag is !{{hoger|lager}} dan [[cop]]"
      },
      "args": [
        {
          "name": "cop",
          "type": "number",
          "title": {
            "en": "COP",
            "nl": "COP"
          },
          "min": 0,
          "max": 10,
          "step": 0.1
        }
      ]
    },
    {
      "id": "electric_backup_is_active",
      "title": {
        "en": "The electric backup heater !{{is|isn't}} on",
        "nl": "De elektrische bijverwarming !{{is|is niet}} aan"
      },
      "$filter": "capabilities=electric_backup_active"
    }
  ]
}

{
  "name": {
    "en": "Heat Pump COP",
    "nl": "Warmtepomp COP"
  },
  "height": 110,
  "devices": {
    "type": "app",
    "singular": true,
    "filter": {
      "class": "heatpump",
      "capabilities": "measure_cop_today"
    }
  },
  "settings": [
    {
      "id": "period",
      "type": "dropdown",
      "title": {
        "en": "Period",
        "nl": "Periode"
      },
      "value": "day",
      "values": [
        {
          "id": "day",
          "title": {
            "en": "Today",
            "nl": "Vandaag"
          }
        },
        {
          "id": "week",
          "title": {
            "en": "This week",
            "nl": "Deze week"
          }
        },
        {
          "id": "month",
          "title": {
            "en": "This month",
            "nl": "Deze maand"
          }
        },
        {
          "id": "year",
          "title": {
            "en": "This year",
            "nl": "Dit jaar"
          }
        }
      ]
    }
  ],
  "api": {
    "getCop": {
      "method": "GET",
      "path": "/cop"
    }
  }
}
